# Gatus SMTP credential — ROOT-OWNED SECRET on the Gatus node. chmod 600. NEVER commit.
# Install to /etc/gatus/gatus.env; it is loaded by the systemd drop-in (gatus-smtp.dropin.conf)
# so Gatus can resolve ${SMTP_USERNAME} / ${SMTP_PASSWORD} in config.yaml. Only these two are
# secret — from/to live (non-secret) in config.yaml. Use the SAME app password as mail.env.
SMTP_USERNAME=<your-smtp-username>
SMTP_PASSWORD=
