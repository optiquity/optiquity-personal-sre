# Gatus-node SMTP credential — ROOT-OWNED SECRET. chmod 600. NEVER commit.
# Install to /etc/gatus/gatus.env. Read by ONE of:
#   · gatus-mail-relay (the default — README § Gatus): systemd hands it to the relay read-only
#     (LoadCredential); fleet-mail sends with it. It needs every line below.
#   · Gatus's own email provider (the alternative): the drop-in gatus-smtp.dropin.conf loads it so
#     Gatus can resolve ${SMTP_USERNAME} / ${SMTP_PASSWORD}; from/to then live in config.yaml.
# Use the SAME app password as mail.env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your-smtp-username>
SMTP_PASSWORD=
MAIL_FROM=<sender-address>
MAIL_TO=<recipient-address>
# Optional: the tag in every subject, [<tag>/<Kind>/<Source>] — keep it the same as in mail.env.
# SUBJECT_TAG=Fleet
