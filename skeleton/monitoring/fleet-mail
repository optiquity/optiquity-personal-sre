#!/usr/bin/env python3
"""fleet-mail — send a fleet notification/alert email via SMTP (e.g. a Gmail app password).

A tiny, dependency-free mailer for your operator's automation to raise alarms. Credentials +
defaults come from an env file (KEY=VALUE, # comments ok):
    SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, MAIL_FROM, MAIL_TO, SUBJECT_TAG (optional)
Default env path: $HOME/.config/fleet-monitoring/mail.env  (override with --env or $FLEET_MAIL_ENV).
That env file is a host-local secret (chmod 600) and must NEVER be committed (see guide § 06).

Body comes from --body, --body-file, or stdin (whichever is given; stdin last). A short footer
(host + UTC time) is appended so alerts are self-identifying.

Why SMTP directly (not via your automation platform): alerting must not depend on the very
service it might be alerting about. A standalone mailer with its own credential still fires when
the rest of the stack is down.

THE ONE OWNER OF THE SUBJECT FORMAT. Every fleet email subject is built HERE, by build_subject();
scripts pass the parts, never a hand-made subject:

    [<Tag>/<Kind>/<Source>] <text>        --kind Alert|Report|Digest --source <Source> --text "<text>"

<Tag> is yours: $FLEET_SUBJECT_TAG, else SUBJECT_TAG in the env file, else "Fleet". A raw --subject
is accepted ONLY if it is already in that shape; anything else is REFUSED (exit 2), never sent. A
malformed subject must fail loudly, not arrive quietly: one hand-built subject in one script is
how a fleet's mail filters drift apart (guide § 17, "Alerts a human will actually read").

Usage:
    fleet-mail --kind Alert --source Backup --text "nightly backup failed" --body "disk full on <mount>"
    some_command 2>&1 | fleet-mail --kind Report --source Nightly --text "job output"
    fleet-mail --kind Digest --source Updates --text "weekly" --body-file <path> --to <recipient> --html
    fleet-mail --dry-run --kind Report --source Test --text "hello"   # print subject + body; send nothing
    fleet-mail --subject "[Fleet/Report/Backup] done" --body "…"     # a pre-built subject, validated

Exit: 0 sent (or --dry-run) · 1 send failed · 2 config/usage error, or a malformed subject refused
"""
import argparse, os, re, socket, ssl, sys, smtplib, datetime
from email.message import EmailMessage

DEFAULT_ENV = os.path.expanduser("~/.config/fleet-monitoring/mail.env")
DEFAULT_TAG = "Fleet"
KINDS = ("Alert", "Report", "Digest")
_BAD_SEGMENT = re.compile(r"[\[\]/]")


class UsageError(Exception):
    """A config or usage problem: exit 2, never a send."""


def resolve_tag(file_env=None):
    """$FLEET_SUBJECT_TAG > SUBJECT_TAG in the env file > "Fleet". The form older docs showed,
    FLEET_SUBJECT_PREFIX='[MyFleet', is accepted too."""
    legacy = os.environ.get("FLEET_SUBJECT_PREFIX", "").strip().lstrip("[")
    tag = (os.environ.get("FLEET_SUBJECT_TAG") or (file_env or {}).get("SUBJECT_TAG")
           or legacy or DEFAULT_TAG).strip()
    if not tag or _BAD_SEGMENT.search(tag) or re.search(r"\s", tag):
        raise UsageError(f"bad subject tag {tag!r}: one word, without / [ ] or spaces")
    return tag


def valid_subject(subject, tag=DEFAULT_TAG):
    return bool(re.match(r"^\[" + re.escape(tag) + r"(/[^\[\]/\s][^\[\]/]*)+\] \S", subject or ""))


def build_subject(segments, text, tag=DEFAULT_TAG):
    """THE subject format.  build_subject(["Alert", "Health"], "1 failing", "Fleet")
                                  -> "[Fleet/Alert/Health] 1 failing"
    Raises ValueError rather than build something malformed."""
    segs = [str(x).strip() for x in segments]
    if not segs or any(not x or _BAD_SEGMENT.search(x) for x in segs):
        raise ValueError(f"bad subject path {segments!r}: segments must be non-empty, without / [ ]")
    text = " ".join(str(text).split())                     # one line: no newlines in a subject
    if not text:
        raise ValueError("empty subject text")
    subject = f"[{tag}/{'/'.join(segs)}] {text}"
    if not valid_subject(subject, tag):
        raise ValueError(f"built an invalid subject: {subject!r}")
    return subject


def load_env(path):
    if not os.path.isfile(path):
        raise UsageError(f"env file not found: {path}  (create it from mail.env.template)")
    env = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            env[k.strip()] = v.strip()
    return env


def main(argv=None):
    ap = argparse.ArgumentParser(description="Send a fleet notification email via SMTP.")
    ap.add_argument("-s", "--subject", help="a subject ALREADY in the [<Tag>/…] format")
    ap.add_argument("--kind", choices=KINDS, help="Alert = act now · Report = FYI · Digest = scheduled summary")
    ap.add_argument("--source", help="the subsystem, e.g. Health, Updates, Backup")
    ap.add_argument("--text", help="the descriptive text after the tag")
    ap.add_argument("--body", help="body text (inline)")
    ap.add_argument("--body-file", help="read body from a file")
    ap.add_argument("--to", help="override recipient (default MAIL_TO from env)")
    ap.add_argument("--from", dest="from_", help="override sender (default MAIL_FROM from env)")
    ap.add_argument("--html", action="store_true", help="send body as HTML")
    ap.add_argument("--env", default=os.environ.get("FLEET_MAIL_ENV", DEFAULT_ENV))
    ap.add_argument("--no-footer", action="store_true")
    ap.add_argument("--dry-run", action="store_true",
                    help="print the subject (and body) that WOULD be sent; send nothing, need no credentials")
    a = ap.parse_args(argv)

    try:
        file_env = load_env(a.env) if (not a.dry_run or os.path.isfile(a.env)) else {}
        tag = resolve_tag(file_env)
        parts = (a.kind, a.source, a.text)
        if a.subject and any(parts):
            raise UsageError("give EITHER --subject OR --kind/--source/--text, not both")
        if a.subject:
            if not valid_subject(a.subject, tag):
                raise UsageError(f"REFUSING to send a subject not in the [{tag}/…] format: {a.subject!r}\n"
                                 f"  Build it with --kind/--source/--text instead.")
            subject = a.subject
        elif all(parts):
            try:
                subject = build_subject([a.kind, a.source], a.text, tag)
            except ValueError as e:
                raise UsageError(str(e))
        else:
            raise UsageError("a subject is required: --kind, --source and --text (or a pre-built --subject)")
    except UsageError as e:
        sys.stderr.write(f"fleet-mail: {e}\n")
        return 2

    if a.body is not None:
        body = a.body
    elif a.body_file:
        with open(a.body_file) as f:
            body = f.read()
    elif not sys.stdin.isatty():
        body = sys.stdin.read()
    else:
        body = ""

    if a.dry_run:
        print(subject)
        if body:
            print(); print(body)
        return 0

    host = file_env.get("SMTP_HOST", "smtp.gmail.com")
    port = int(file_env.get("SMTP_PORT", "587"))
    user = file_env.get("SMTP_USERNAME", "")
    pw   = file_env.get("SMTP_PASSWORD", "")
    mfrom = a.from_ or file_env.get("MAIL_FROM") or user
    mto   = a.to or file_env.get("MAIL_TO", "")
    if not (user and pw):
        sys.stderr.write(f"fleet-mail: SMTP_USERNAME/SMTP_PASSWORD missing in {a.env}\n")
        return 2
    if not mto:
        sys.stderr.write(f"fleet-mail: no recipient (set MAIL_TO in {a.env} or pass --to)\n")
        return 2

    if not a.no_footer:
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
        body = (body.rstrip() + f"\n\n—\nfleet-mail · {socket.gethostname()} · {stamp}\n")

    msg = EmailMessage()
    msg["Subject"] = subject
    msg["From"] = mfrom
    msg["To"] = mto
    msg.set_content(body, subtype=("html" if a.html else "plain"))

    try:
        ctx = ssl.create_default_context()
        if port == 465:
            with smtplib.SMTP_SSL(host, port, timeout=30, context=ctx) as s:
                s.login(user, pw); s.send_message(msg)
        else:
            with smtplib.SMTP(host, port, timeout=30) as s:
                s.ehlo(); s.starttls(context=ctx); s.ehlo()
                s.login(user, pw); s.send_message(msg)
    except Exception as e:
        sys.stderr.write(f"fleet-mail: send failed via {host}:{port} as {user}: {e}\n")
        return 1
    print(f"fleet-mail: sent '{subject}' -> {mto}")
    return 0

if __name__ == "__main__":
    sys.exit(main())
