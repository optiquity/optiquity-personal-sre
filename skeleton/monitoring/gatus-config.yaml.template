# Gatus config — fleet health (infra + your app stack), with email alerts on failure.
# Gatus (https://github.com/TwiN/gatus) is a tiny Go health-check dashboard: it periodically
# hits each endpoint and asserts CONDITIONS, then alerts when they fail. Runs great native on a
# gateway/Pi with in-memory storage (zero disk writes).
#
# Install to the Gatus config path on the node running it (e.g. /etc/gatus/config.yaml) and fill
# every <placeholder>. Alerts go through gatus-mail-relay (README § Gatus), which needs the SMTP
# settings in /etc/gatus/gatus.env (see gatus.env.template). Conditions verify FUNCTION (status + body + latency), not just a
# ping — that's what catches "up but broken".
storage:
  type: memory                       # no disk writes; history lives in RAM
  maximum-number-of-results: 100

web:
  address: 127.0.0.1                 # bind local; expose privately via your mesh/reverse proxy
  port: 8080

ui:
  title: "fleet health"
  header: "fleet health — infra + apps"

# ── Alerting: through gatus-mail-relay ──────────────────────────────────────
# Gatus hard-codes its email subject (v5.36: "<group>/<name>: Alert triggered") and has no setting to
# change it. Its `custom` provider POSTs each alert to a URL instead; the relay on this host
# (127.0.0.1 only) builds the subject with fleet-mail, so health-check mail matches the rest:
#   [Fleet/Alert/Metrics/node_exporter] node_exporter (gateway): triggered
# The placeholders below are substituted as raw text — the relay copes with quotes/newlines in
# [RESULT_ERRORS]. No credential lives here or in Gatus's environment: the relay holds it.
alerting:
  custom:
    url: "http://127.0.0.1:8099/alert"
    method: "POST"
    headers:
      Content-Type: "application/json"
    body: |
      {"group": "[ENDPOINT_GROUP]", "name": "[ENDPOINT_NAME]", "state": "[ALERT_TRIGGERED_OR_RESOLVED]", "description": "[ALERT_DESCRIPTION]", "url": "[ENDPOINT_URL]", "errors": "[RESULT_ERRORS]", "conditions": "[RESULT_CONDITIONS]"}
    default-alert:
      failure-threshold: 3           # N consecutive failures before it alerts (dampens blips)
      success-threshold: 2
      send-on-resolved: true         # also alert when it recovers

# The ALTERNATIVE — Gatus's own email provider (its fixed subject; add a second mail filter), with
# SMTP creds from the environment via gatus-smtp.dropin.conf. Use it INSTEAD of `custom` above, and
# change every endpoint's alerts to [{type: email}]:
#  email:
#    from: "<sender-address>"
#    to: "<recipient-address>"
#    host: "smtp.gmail.com"
#    port: 587
#    username: ${SMTP_USERNAME}      # resolved from the environment — never a literal here
#    password: ${SMTP_PASSWORD}
#    default-alert: {failure-threshold: 3, success-threshold: 2, send-on-resolved: true}

endpoints:
  # ── Infra: reachability (TCP/ICMP/DNS) ────────────────────────────────────
  - name: Internet
    group: Core
    url: "https://1.1.1.1"
    interval: 60s
    conditions: ["[STATUS] == 200"]
    alerts: [{type: custom}]

  - name: DNS
    group: Core
    url: "8.8.8.8"
    interval: 60s
    dns: {query-name: "example.com", query-type: "A"}
    conditions: ["[DNS_RCODE] == NOERROR"]
    alerts: [{type: custom}]

  - name: Router
    group: LAN
    url: "tcp://<router-ip>:80"
    interval: 2m
    conditions: ["[CONNECTED] == true"]
    alerts: [{type: custom}]

  - name: NAS
    group: LAN
    url: "tcp://<nas-ip>:5000"
    interval: 2m
    conditions: ["[CONNECTED] == true"]
    alerts: [{type: custom}]

  - name: Always-on host
    group: LAN
    url: "tcp://<server-ip>:22"
    interval: 2m
    conditions: ["[CONNECTED] == true"]
    alerts: [{type: custom}]

  # ── Apps: functional checks (status + body + latency), not just up/down ───
  # Repeat this shape per self-hosted service. Pick a no-auth health path and a body marker.
  - name: Automation platform            # e.g. an n8n / workflow engine
    group: Apps
    url: "https://<service-host>/healthz"
    interval: 2m
    conditions:
      - "[STATUS] == 200"
      - "[BODY].status == ok"            # JSON field assertion
      - "[RESPONSE_TIME] < 3000"
    alerts: [{type: custom}]

  - name: Media server                   # e.g. Plex /identity (no auth, returns server id)
    group: Apps
    url: "http://<server-ip>:32400/identity"
    interval: 2m
    conditions:
      - "[STATUS] == 200"
      - "[BODY] == pat(*machineIdentifier*)"   # substring/glob match on the raw body
      - "[RESPONSE_TIME] < 3000"
    alerts: [{type: custom}]

  - name: Dashboards                     # e.g. Grafana /api/health -> {"database":"ok"}
    group: Apps
    url: "https://<service-host>/api/health"
    interval: 2m
    conditions:
      - "[STATUS] == 200"
      - "[BODY].database == ok"
      - "[RESPONSE_TIME] < 3000"
    alerts: [{type: custom}]

  - name: Login-walled UI                # e.g. a UI that 200s on its login page
    group: Apps
    url: "https://<service-host>/auth/login"
    interval: 2m
    conditions:
      - "[STATUS] == 200"
      - "[BODY] == pat(*<expected-marker>*)"
      - "[RESPONSE_TIME] < 3000"
    alerts: [{type: custom}]
