#!/usr/bin/env python3
"""fleet-update-check — surface AVAILABLE software updates across your fleet, by install
method, and email an actionable digest. NOTIFY-ONLY: it never upgrades anything.

This is the automation half of the "deliberate update pass" (guide example E10): instead of
letting nodes auto-update (a surprise-breakage risk on always-on hosts), a scheduled job
*inventories* what's behind and emails you the list — you run the upgrades deliberately, per
node, from your runbook. Reads are always free (governance Rule 10); this tool only reads.

Nodes come from a config file (default $HOME/.config/fleet-monitoring/fleet-nodes.conf, override
with --config or $FLEET_NODES) — one line per node:

    # role | ssh-target (or "local") | os | methods (comma: brew,npm,softwareupdate,apt,manual)
    always-on | local          | macos    | brew,npm,softwareupdate,uvtool,pipx
    laptop    | <laptop-host>   | macos    | brew,npm,softwareupdate
    gateway   | <gateway-host>  | linux    | apt
    windows   | <win-host>      | windows  | winget
    nas       | <nas-host>      | synology | manual

Local macos/linux nodes run via a login shell (to pick up brew/npm); remote nodes over SSH
(key auth, BatchMode); Windows nodes get the command as-is (their SSH shell is cmd/PowerShell).
"manual" emits an OS-specific reminder (guide § 16: detecting often works over SSH even where
INSTALLING needs an elevated or UI session). Emails via a mailer command (default: fleet-mail)
when there are updates, coverage findings OR errors; silent when all-current (--always forces,
--dry-run prints instead). --refresh also refreshes indexes first (brew/apt) for exact counts.

COVERAGE — the question a list of checks cannot answer is "what is installed that NOTHING checks?"
  · methods: `name` = checked · `!name` = excluded on purpose (still counted, never silent) ·
    `?name` = a known gap, not checked yet (reported every run) · `not-audited` = nobody has looked.
  · a declared method this checker has no code for is reported as NO CHECKER — never as "current".
  · discovery reconciles declared methods against what is ACTUALLY installed (macos/linux).
  · fleet-binaries.conf: binaries installed by hand, outside any package manager (a tool you
    downloaded, your own scripts). Discovery walks /usr/local/bin (+ /opt on Linux, + any folders in
    the node's optional 5th column); anything
    found but unregistered is REPORTED. `upstream` rows are version-checked against GitHub.
  · fleet-update-decisions.conf: recorded decisions ("frozen", "declined", …) with a revisit date;
    a denial is a durable answer, but one whose date has passed surfaces again.
  · a malformed row in any of these files is REPORTED, never silently skipped.
An unreachable node is noted and skipped — a laptop asleep is not an error.

Exit: 0 ok · 1 the digest email failed to send · 2 config error
"""
import argparse, os, re, shlex, subprocess, sys, datetime

SSH = ["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes"]
CONF_DIR = os.path.expanduser("~/.config/fleet-monitoring")
DEFAULT_CONFIG = os.path.join(CONF_DIR, "fleet-nodes.conf")
BINARIES_CONF = os.environ.get("FLEET_BINARIES", os.path.join(CONF_DIR, "fleet-binaries.conf"))
DECISIONS_CONF = os.environ.get("FLEET_DECISIONS", os.path.join(CONF_DIR, "fleet-update-decisions.conf"))
# Methods this checker has code for. A declared method outside this set is reported as NO CHECKER.
CHECKERS = {"brew", "npm", "softwareupdate", "apt", "uvtool", "pipx", "winget", "manual"}
MANUAL_HINT = {
    "windows":  "detect over SSH: winget list --disable-interactivity (cached index); install from an elevated session: winget upgrade --all --include-unknown --accept-source-agreements",
    "synology": "DSM → Package Center → Installed → Update. Sideloaded packages (e.g. a mesh-VPN .spk) update manually.",
    "nas":      "check the NAS admin UI for package/OS updates.",
}

def sh(args, timeout=300):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout or "").strip(), (p.stderr or "").strip()
    except subprocess.TimeoutExpired:
        return 124, "", "timed out"
    except Exception as e:
        return 1, "", str(e)

def read_conf(path, fields, optional=0):
    """(rows, errors) for a pipe-delimited registry: `fields` required columns, up to `optional` more.
    A malformed row is RETURNED as an error rather than skipped: silently dropping a line is how a
    registered thing becomes unregistered without anyone being told — the blind spot these
    registries exist to close."""
    rows, errs = [], []
    with open(path) as fh:
        for n, raw in enumerate(fh, 1):
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            parts = [p.strip() for p in line.split("|")]
            if not fields <= len(parts) <= fields + optional or not all(parts):
                want = f"{fields}-{fields + optional}" if optional else f"{fields}"
                errs.append(f"{os.path.basename(path)}:{n}: expected {want} non-empty fields, got {len(parts)}")
                continue
            rows.append(tuple(parts))
    return rows, errs

def load_nodes(path):
    """(nodes, errors)."""
    if not os.path.isfile(path):
        sys.exit(f"fleet-update-check: node config not found: {path}  (copy fleet-nodes.conf.template)")
    rows, errs = read_conf(path, 4, optional=1)
    nodes = [{"role": r[0], "target": r[1], "os": r[2],
              "methods": [m.strip() for m in r[3].split(",") if m.strip()],
              # optional 5th column: extra folders for this node's hand-placed-binary discovery
              "extra": [d.strip() for d in r[4].split(",") if d.strip()] if len(r) > 4 else []}
             for r in rows]
    return nodes, errs

def run_on(node, cmd, timeout=300):
    if node["os"] == "windows":            # the SSH shell is cmd/PowerShell: no POSIX login shell
        return sh(SSH + [node["target"], cmd], timeout)
    shell = "zsh -lc" if node["os"] == "macos" else "bash -lc"
    if node["target"] == "local":
        return sh(shell.split() + [cmd], timeout)
    return sh(SSH + [node["target"], f"{shell} {shlex.quote(cmd)}"], timeout)

def reachable(node):
    """`echo ok`, not `true`: a Windows node's SSH shell has no `true`, so the old probe read every
    Windows node as unreachable."""
    if node["target"] == "local":
        return True
    rc, out, _ = sh(SSH + [node["target"], "echo ok"], 12)
    return rc == 0 and out.strip() == "ok"

def method_sets(node):
    """(checked, excluded, gaps, not_audited) from a node's methods column."""
    ms = node["methods"]
    return ({m for m in ms if m[:1] not in "!?" and m != "not-audited"},
            {m[1:] for m in ms if m.startswith("!")},
            {m[1:] for m in ms if m.startswith("?")},
            "not-audited" in ms)

# ── Coverage reconciliation ──────────────────────────────────────────────────
# How to detect that an install method is PRESENT AND HOLDING PACKAGES on a node.
# Presence alone is not a gap: a tool installed with nothing installed *into* it
# needs no checker, and reporting it would be noise that teaches you to skim.
#
# This exists because the alternative — a hand-maintained list of things to check
# — has a permanent blind spot: it only ever contains what someone remembered to
# add. Every "we forgot to check X" gets fixed by adding one more special case,
# and the next one is already waiting. Reconciliation asks the question the other
# way round: what is installed here that nothing is watching?
#
# Adding a method is ONE line here plus the method name in fleet-nodes.conf.
METHOD_PROBES = {
    # grep -c, never wc -l: macOS pads wc's output ("       2"), which the parser cannot read,
    # so brew was never discovered at all.
    "brew":      'command -v brew >/dev/null && brew list --formula 2>/dev/null | grep -c . || echo 0',
    "npm":       'command -v npm >/dev/null && npm ls -g --depth=0 2>/dev/null | tail -n +2 | grep -c . || echo 0',
    "pnpm":      'command -v pnpm >/dev/null && pnpm ls -g --depth=0 2>/dev/null | grep -cE "^[a-z@]" || echo 0',
    "yarn":      'command -v yarn >/dev/null && yarn global list 2>/dev/null | grep -c "info " || echo 0',
    "pipx":      'command -v pipx >/dev/null && pipx list --short 2>/dev/null | grep -c . || echo 0',
    "uvtool":    'command -v uv >/dev/null && uv tool list 2>/dev/null | grep -cE "^[a-z]" || echo 0',
    "pipuser":   'command -v pip3 >/dev/null && pip3 list --user 2>/dev/null | tail -n +3 | grep -c . || echo 0',
    "gem":       'command -v gem >/dev/null && gem list --no-versions 2>/dev/null | grep -c . || echo 0',
    "cargo":     'ls ~/.cargo/bin 2>/dev/null | grep -c . || echo 0',
    "gobin":     'ls ~/go/bin 2>/dev/null | grep -c . || echo 0',
    "deno":      'ls ~/.deno/bin 2>/dev/null | grep -c . || echo 0',
    "nodeversion": 'ls ~/.nvm/versions/node 2>/dev/null | grep -c . || echo 0',
    "vscode":    'command -v code >/dev/null && code --list-extensions 2>/dev/null | grep -c . || echo 0',
    "apt":       'command -v apt >/dev/null && echo 1 || echo 0',
    "snap":      'command -v snap >/dev/null && snap list 2>/dev/null | tail -n +2 | grep -c . || echo 0',
    "flatpak":   'command -v flatpak >/dev/null && flatpak list 2>/dev/null | grep -c . || echo 0',
}

# Methods a node may legitimately hold without a checker. Declare them in
# fleet-nodes.conf as `!name` (e.g. `!gem`) so they are EXCLUDED-BUT-COUNTED
# rather than silently absent — an exclusion that vanishes from the report is
# indistinguishable from a gap in coverage.


def reconcile_node(node):
    """Report install methods that hold packages but are not declared for this node.

    Returns (lines, count, errs). A finding here is not an error — it means
    something is installed that nothing is watching.
    """
    checked, excluded, gaps, not_audited = method_sets(node)
    declared = checked | excluded | gaps
    lines, count = [], 0
    if not_audited:
        lines.append("  NOT AUDITED  nobody has assessed how this node updates — look, then declare methods")
        count += 1
    for m in sorted(checked - CHECKERS):
        lines.append(f"  NO CHECKER  {m} — declared, but this checker has no code for it: it is NOT checked")
        count += 1
    for m in sorted(gaps):
        lines.append(f"  GAP         {m} — a known gap, not checked yet")
        count += 1
    if node["os"] not in ("macos", "linux"):
        lines.append(f"  (discovery not supported for os '{node['os']}' — declare its methods by hand)")
        return lines, count, []

    probe = "; ".join(f'printf "%s=" {shlex.quote(m)}; ({c})' for m, c in METHOD_PROBES.items())
    rc, out, err = run_on(node, probe, timeout=180)
    if rc != 0 and not out.strip():
        return lines, count, [f"method discovery failed ({err.strip()[:80] or 'no output'})"]

    for m in METHOD_PROBES:
        match = re.search(rf"{re.escape(m)}=(\d+)", out)
        if not match:
            continue
        n = int(match.group(1))
        if n == 0:
            continue                       # installed nothing -> not a gap
        if m in excluded:
            continue                       # counted below, not silent
        if m not in declared:
            lines.append(f"  UNDECLARED  {m} ({n} installed) — nothing checks this")
            count += 1
    if excluded:
        lines.append(f"  excluded ({len(excluded)}): {', '.join(sorted(excluded))}")
    if not count and not excluded:
        lines.append("  every install method in use is declared and checked")
    return lines, count, []


def check_node(node, refresh):
    """Return (lines, count, errors) for one node across its methods."""
    lines, count, errs = [], 0, []
    checked = method_sets(node)[0]
    for m in [m for m in node["methods"] if m in checked]:
        if m == "brew":
            upd = "brew update >/dev/null 2>&1; " if refresh else ""
            rc, out, err = run_on(node, f'{upd}echo "==F=="; brew outdated --formula --verbose 2>/dev/null; '
                                        f'echo "==C=="; brew outdated --cask 2>/dev/null')
            if rc == 124 or (rc != 0 and not out):
                errs.append(f"brew: {err or 'failed'}"); continue
            formula = out.split("==C==")[0].replace("==F==", "").strip()
            cask = out.split("==C==")[1].strip() if "==C==" in out else ""
            if not refresh and (formula or cask):
                lines.append("(brew index not refreshed — run with --refresh for exact counts)")
            for label, blob in (("Homebrew formulae", formula), ("Homebrew casks", cask)):
                items = [l for l in blob.splitlines() if l.strip()]
                if items:
                    count += len(items); lines.append(f"{label} ({len(items)}):"); lines += [f"  {l}" for l in items]
        elif m == "npm":
            rc, out, err = run_on(node, "npm outdated -g 2>/dev/null")
            items = [l for l in out.splitlines() if l.strip() and not l.startswith("Package")]
            if items:
                count += len(items); lines.append(f"npm globals ({len(items)}):"); lines += [f"  {l}" for l in items]
        elif m == "softwareupdate":
            rc, out, err = run_on(node, "softwareupdate -l 2>&1")
            items = [l.strip() for l in out.splitlines() if l.strip().startswith("*") or l.strip().startswith("Title:")]
            if items:
                count += len(items); lines.append("macOS (softwareupdate — not auto-applied):"); lines += [f"  {l}" for l in items]
        elif m == "apt":
            upd = "sudo apt-get update -qq >/dev/null 2>&1; " if refresh else ""
            rc, out, err = run_on(node, f'{upd}apt list --upgradable 2>/dev/null | grep -v "^Listing"')
            items = [l for l in out.splitlines() if l.strip()]
            if rc == 124:
                errs.append(f"apt: {err or 'timed out'}")
            elif items:
                count += len(items); lines.append(f"apt upgradable ({len(items)}):"); lines += [f"  {l}" for l in items]
        elif m == "uvtool":
            # Tools installed by a Python tool-installer are a classic blind spot: they sit
            # outside brew/npm/apt entirely, so nothing reports them stale. uv has no
            # --outdated, so compare `uv tool list` against the package index.
            rc, out, err = run_on(node, "uv tool list 2>/dev/null")
            pairs = [(p_[0], p_[1].lstrip("v")) for p_ in
                     (l.split() for l in out.splitlines()) if len(p_) >= 2 and p_[1].startswith("v")]
            behind = []
            for name, cur in pairs:
                try:
                    import json as _j, urllib.request as _u
                    with _u.urlopen(f"https://pypi.org/pypi/{name}/json", timeout=15) as r:
                        latest = _j.load(r)["info"]["version"]
                    if latest != cur:
                        behind.append(f"{name} {cur} < {latest}")
                except Exception as e:
                    behind.append(f"{name} {cur} (check failed: {str(e)[:40]})")
            if behind:
                count += len(behind); lines.append(f"uv tools ({len(behind)}):"); lines += [f"  {b}" for b in behind]
        elif m == "pipx":
            rc, out, err = run_on(node, "pipx list --outdated --short 2>/dev/null")
            items = [l for l in out.splitlines() if l.strip() and not l.lower().startswith(("nothing", "no "))]
            if items:
                count += len(items); lines.append(f"pipx ({len(items)}):"); lines += [f"  {l}" for l in items]
        elif m == "winget":
            rc, out, err = run_on(node, "winget upgrade --include-unknown --disable-interactivity")
            if rc == 124 or (rc != 0 and not out):
                errs.append(f"winget: {err or 'failed'}"); continue
            items = parse_winget(out)
            if items:
                count += len(items)
                lines.append(f"winget ({len(items)}) — from cache: the source index cannot refresh without elevation:")
                lines += [f"  {l}" for l in items]
        elif m == "manual":
            lines.append("MANUAL: " + MANUAL_HINT.get(node["os"], "check this node's native updater manually."))
    if not lines and not errs:
        lines.append("current — nothing outdated")
    return lines, count, errs

def parse_winget(out):
    """Upgradable rows from `winget upgrade --disable-interactivity`: only the rows of the TABLE,
    i.e. after the dashed separator under its header, up to the "N upgrades available" summary.
    Everything before the separator — progress spinners, "Failed in attempting to update the
    source" (the index needs elevation to refresh, so results come from cache), the header — is not
    a package. No separator means no table ("no upgrades"), so no rows."""
    rows, in_table = [], False
    for line in out.splitlines():
        t = line.strip()
        if not in_table:
            in_table = bool(re.match(r"^-{5,}$", t))
            continue
        if re.search(r"upgrades? available", t, re.I) or not t:
            break
        rows.append(t)
    return rows

def github_latest(repo):
    """The latest release tag of <owner>/<repo> on GitHub (unauthenticated: 60 requests/hour)."""
    import json as _j, urllib.request as _u
    with _u.urlopen(f"https://api.github.com/repos/{repo}/releases/latest", timeout=20) as r:
        return (_j.load(r).get("tag_name") or "").strip()

# Discovery of binaries placed by hand: executables no package manager owns. The default folders,
# plus any a node adds in fleet-nodes.conf's optional 5th column.
# ⚠ Add a folder only if hand-placed programs really live there. A folder full of config-managed
# scripts and tool shims makes nearly every entry "unregistered" (one fleet measured 35 of 36),
# and a digest with permanent rows trains its reader to ignore it.
DISCOVERY_DIRS = {"linux": ["/usr/local/bin", "/opt"], "macos": ["/usr/local/bin"]}

def _shdir(d):
    """A folder for the probe's shell: quoted, with a leading ~/ resolved in the (remote) $HOME."""
    return ('"$HOME"/' + shlex.quote(d[2:])) if d.startswith("~/") else shlex.quote(d)

def binary_probe(os_, extra=()):
    """The discovery command for one node, or None where discovery isn't supported."""
    if os_ not in DISCOVERY_DIRS:
        return None
    dirs = [_shdir(d) for d in [*DISCOVERY_DIRS[os_], *extra]]
    if os_ == "linux":
        # read line by line: a `for f in $(find …)` loop would split a path with a space in two
        return (f'find {" ".join(dirs)} -maxdepth 2 -type f -perm -u+x 2>/dev/null | while IFS= read -r f; do '
                '(dpkg -S "$f" >/dev/null 2>&1 || rpm -qf "$f" >/dev/null 2>&1) || echo "$f"; done')
    return (f'for f in {" ".join(d + "/*" for d in dirs)}; do [ -f "$f" ] && [ -x "$f" ] || continue; '
            'case "$(readlink -f "$f" 2>/dev/null)" in /opt/homebrew/*|/usr/local/Cellar/*|/usr/local/Caskroom/*) ;; '
            '*) echo "$f";; esac; done')

def binaries_block(nodes, reach):
    """(lines, count, errs): unregistered / missing / behind hand-placed binaries."""
    if not os.path.isfile(BINARIES_CONF):
        reg, errs = {}, []
        note = f"  (no {os.path.basename(BINARIES_CONF)} yet — every hand-placed binary found is UNREGISTERED)"
    else:
        rows, errs = read_conf(BINARIES_CONF, 5)
        reg = {(r[0], r[1]): (r[2], r[3], r[4]) for r in rows}
        note = None
    lines, count = ([note] if note else []), 0
    for node in nodes:
        probe = binary_probe(node["os"], node.get("extra", ()))
        if not probe or not reach.get(node["role"]):
            continue
        rc, out, err = run_on(node, probe, timeout=120)
        if rc == 124:
            errs.append(f"{node['role']}: binary discovery timed out"); continue
        found = sorted(l.strip() for l in out.splitlines() if l.strip())
        for path in found:
            if (node["role"], path) not in reg:
                lines.append(f"  UNREGISTERED  {node['role']}: {path} — add it to {os.path.basename(BINARIES_CONF)}")
                count += 1
                continue
            kind, source, rx = reg[(node["role"], path)]
            if kind != "upstream":
                continue
            _, cur, _ = run_on(node, f"strings {shlex.quote(path)} 2>/dev/null | grep -oE {shlex.quote(rx)} | sort -u | tail -1")
            cur = (cur or "").strip()
            try:
                latest = github_latest(source)
            except Exception as e:
                errs.append(f"{os.path.basename(path)}: upstream lookup failed ({type(e).__name__})"); continue
            if not cur:
                lines.append(f"  UNREADABLE  {node['role']}: {path} — installed version unreadable; latest {latest}")
                count += 1
            elif latest and cur != latest:
                lines.append(f"  {node['role']}: {os.path.basename(path)} {cur} -> {latest}   ({source})")
                count += 1
        for (role, path) in reg:
            if role == node["role"] and path not in found:
                lines.append(f"  MISSING     {role}: {path} — registered but not found (removed? then unregister it)")
                count += 1
    if not lines:
        lines.append("  every hand-placed binary is registered and current")
    return lines, count, errs

def decisions_block():
    """(lines, count, errs): recorded update decisions, and any whose revisit date has passed."""
    if not os.path.isfile(DECISIONS_CONF):
        return ["  none recorded"], 0, []
    rows, errs = read_conf(DECISIONS_CONF, 5)
    today = datetime.date.today().isoformat()
    lines, count, by_kind = [], 0, {}
    for role, item, kind, reason, revisit in rows:
        if revisit != "-" and not re.match(r"^\d{4}-\d{2}-\d{2}$", revisit):
            errs.append(f"{os.path.basename(DECISIONS_CONF)}: revisit {revisit!r} for {item} is not YYYY-MM-DD or -")
            continue
        by_kind.setdefault(kind, []).append(f"{role}:{item}")
        if revisit != "-" and revisit <= today:
            lines.append(f"  REVISIT DUE  {role}: {item} ({kind}, set for {revisit}) — {reason[:90]}")
            count += 1
    for kind in sorted(by_kind):
        lines.append(f"  {kind} ({len(by_kind[kind])}): {', '.join(by_kind[kind])}")
    return lines or ["  none recorded"], count, errs

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--config", default=os.environ.get("FLEET_NODES", DEFAULT_CONFIG))
    ap.add_argument("--mailer", default=os.environ.get("FLEET_MAILER", os.path.expanduser("~/.local/bin/fleet-mail")))
    ap.add_argument("--refresh", action="store_true", help="refresh package indexes first (brew/apt update)")
    ap.add_argument("--always", action="store_true", help="email even when nothing is outdated")
    ap.add_argument("--dry-run", action="store_true", help="print the digest; do not email")
    a = ap.parse_args()

    nodes, conf_errs = load_nodes(a.config)
    reach = {n["role"]: reachable(n) for n in nodes}
    blocks, summary, any_updates, any_errs = [], [], False, bool(conf_errs)
    if conf_errs:
        blocks.append("\n".join(["== Config problems — fix these; a skipped row is a node nobody checks =="]
                                 + [f"  {e}  ⚠" for e in conf_errs]))
        summary.append(f"config ERR {len(conf_errs)}")
    for node in nodes:
        if not reach[node["role"]]:
            blocks.append(f"== {node['role']} ({node['os']}) — unreachable, skipped ==\n"
                          "  not an error (a laptop asleep, a node offline) — it is checked when it answers")
            summary.append(f"{node['role']} skipped")
            continue
        lines, cnt, errs = check_node(node, a.refresh)
        any_updates = any_updates or cnt > 0
        any_errs = any_errs or bool(errs)
        tag = f"{cnt} update(s)" if cnt else ("ERROR" if errs else "current")
        body = [f"== {node['role']} ({node['os']}) — {tag} =="]
        body += [f"  {e}  ⚠" for e in errs] + lines
        blocks.append("\n".join(body))
        summary.append(f"{node['role']} {cnt if cnt else ('ERR' if errs else 'ok')}")

    # Coverage reconciliation — what is installed that nothing is watching.
    # Deliberately a separate pass: the per-node blocks above answer "is anything
    # I check out of date", which is a different and much weaker question.
    rec_lines, rec_count, rec_errs = [], 0, []
    for node in nodes:
        if not reach[node["role"]]:
            continue
        l, c, e = reconcile_node(node)
        if l or e:
            rec_lines.append(f"  {node['role']} ({node['os']}):")
            rec_lines += [f"  {x}" for x in l] + [f"    {x}  ⚠" for x in e]
        rec_count += c
        rec_errs += e
    any_updates = any_updates or rec_count > 0
    any_errs = any_errs or bool(rec_errs)
    tag = f"{rec_count} finding(s)" if rec_count else ("ERROR" if rec_errs else "current")
    blocks.append("\n".join([f"== Update coverage (reconciliation) — {tag} ==",
                             "  Declared methods vs what is actually installed. UNDECLARED: installed,",
                             "  nothing checks it. NO CHECKER: declared, but this tool has no code for it.",
                             "  GAP: a known gap. NOT AUDITED: nobody has looked. Declare `name` to check,",
                             "  `!name` to exclude with intent (still counted), `?name` for a known gap."] + rec_lines))

    # Binaries placed by hand — invisible to every package manager above.
    bin_lines, bin_count, bin_errs = binaries_block(nodes, reach)
    any_updates = any_updates or bin_count > 0
    any_errs = any_errs or bool(bin_errs)
    tag = f"{bin_count} finding(s)" if bin_count else ("ERROR" if bin_errs else "current")
    blocks.append("\n".join([f"== Hand-placed binaries ({os.path.basename(BINARIES_CONF)}) — {tag} =="]
                             + bin_lines + [f"  {e}  ⚠" for e in bin_errs]))
    summary.append(f"binaries {bin_count if bin_count else ('ERR' if bin_errs else 'ok')}")

    # Recorded decisions — durable, but not forever.
    dec_lines, dec_count, dec_errs = decisions_block()
    any_updates = any_updates or dec_count > 0
    any_errs = any_errs or bool(dec_errs)
    tag = f"{dec_count} due for review" if dec_count else ("ERROR" if dec_errs else "none due")
    blocks.append("\n".join([f"== Update decisions ({os.path.basename(DECISIONS_CONF)}) — {tag} =="]
                             + dec_lines + [f"  {e}  ⚠" for e in dec_errs]))
    summary.append(f"coverage {rec_count if rec_count else ('ERR' if rec_errs else 'ok')}")

    stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    header = (f"Fleet update digest — {stamp}\n"
              f"Summary — {' | '.join(summary)}\n"
              f"Notify-only: nothing was upgraded. Run the per-node upgrades from your update runbook (guide E10).\n"
              + ("Package indexes were refreshed.\n" if a.refresh else "Indexes NOT refreshed (run with --refresh for exact counts).\n"))
    digest = header + "\n" + "\n\n".join(blocks) + "\n"

    # fold the pinned-container-image check in — containers are invisible to brew/npm/apt, so a
    # version-pinned image rots silently until someone spots a banner in the app's own UI
    # Exit 1 = updates (or an unregistered stack); exit 2 = a check FAILED — an error, never "no updates".
    container_updates = container_errs = False
    cc = os.path.expanduser("~/.local/bin/fleet-container-check")
    if os.path.exists(cc):
        try:
            cr = subprocess.run([cc], capture_output=True, text=True, timeout=180)
            container_updates = cr.returncode == 1 or "[UP]" in cr.stdout
            container_errs = cr.returncode not in (0, 1)
            digest += "\n\n" + "=" * 56 + "\n" + (cr.stdout or "(no container output)")
            if container_errs:
                digest += f"\n  ⚠ container check exited {cr.returncode}: {(cr.stderr or '').strip()[:200]}\n"
        except Exception as e:
            container_errs = True
            digest += f"\n\n(container image check failed to run: {e})\n"

    # fold the generalized install-method audit into the weekly digest (if the tool is installed)
    audit_conflict = False
    audit = os.path.expanduser("~/.local/bin/fleet-install-audit")
    if os.path.exists(audit):
        try:
            ar = subprocess.run([audit, "--dry-run"], capture_output=True, text=True, timeout=240)
            audit_conflict = ar.returncode != 0
            digest += "\n\n" + "=" * 56 + "\n" + (ar.stdout or "(no audit output)")
        except Exception as e:
            digest += f"\n\n(install-method audit failed to run: {e})\n"

    if a.dry_run:
        print(digest); return 0
    any_errs = any_errs or container_errs
    if not (any_updates or any_errs or audit_conflict or container_updates or a.always):
        print("fleet-update-check: everything current, no errors, no install conflicts — no email sent.")
        return 0
    tags = []
    if any_updates: tags.append("updates available")
    if container_updates: tags.append("container images")
    if audit_conflict: tags.append("install conflicts")
    if any_errs: tags.append("check errors")
    tag = " + ".join(tags) or "summary"
    # fleet-mail builds the subject — never a hand-made one here (guide § 17, "Alerts a human will actually read")
    p = subprocess.run([a.mailer, "--kind", "Digest", "--source", "Updates", "--text", f"{tag} ({stamp})",
                        "--body", digest])
    if p.returncode != 0:
        sys.stderr.write("fleet-update-check: mailer failed to send the digest\n")
        return 1
    return 0

if __name__ == "__main__":
    sys.exit(main())
