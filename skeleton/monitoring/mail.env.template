# fleet-mail SMTP credential — HOST-LOCAL SECRET. chmod 600. NEVER commit (guide § 06).
# Copy to $HOME/.config/fleet-monitoring/mail.env and fill in the values.
#
# For a Gmail app password: enable 2-Step Verification, then create an app password at
# your Google account's App passwords page; SMTP_USERNAME is your full Gmail address.
# MAIL_FROM may be a display name + a plus-tagged address you own (the tag rides your real
# address, so the provider accepts it and you can filter on it) — e.g. put "+alerts" before
# the "@" in your own address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your-smtp-username>
SMTP_PASSWORD=
MAIL_FROM=<sender-address>
MAIL_TO=<recipient-address>
